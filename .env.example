# Copy to .env. No secrets belong in this file.
CSO_MODE=replay
CSO_DATABASE_URL=sqlite+aiosqlite:///./cso.db
# Leave unset in replay mode to use precomputed receipts; set when a Decider server is running.
# CSO_DECIDER_URL=http://127.0.0.1:8099
CSO_BEDROCK_REGION=us-east-1
CSO_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Replace <REPO_URL> and <CONTACT_EMAIL> with real values; live mode refuses to start until you do.
CSO_USER_AGENT=ChangesetSecondOpinion/0.1 (+<REPO_URL>; <CONTACT_EMAIL>)
CSO_JOBS_WORKER_ENABLED=true
# Caddy site address for compose (":80" for plain HTTP, or a domain for automatic TLS).
CSO_SITE_ADDRESS=:80
# Decider timeout class: gpu (45 s) or cpu (90 s).
CSO_DECIDER_DEVICE_CLASS=gpu

# Observability and spend guards (UTC day). For the analysis and draft caps, 0 allows none (fail closed) and a negative value turns the cap off.
# CSO_LOG_LEVEL=INFO
# CSO_LOG_FORMAT=auto            # auto = JSON in live mode, console in replay
# CSO_DAILY_ANALYSIS_CAP=200
# CSO_DAILY_DRAFT_CAP=100
# CSO_BEDROCK_DAILY_USD_CAP=10   # above this, drafts fall back to the template

# Optional Bedrock price overrides (USD per million tokens); unset uses the built-in estimate table.
# CSO_BEDROCK_INPUT_USD_PER_MTOK=
# CSO_BEDROCK_OUTPUT_USD_PER_MTOK=
# Behind the compose Caddy the API must trust X-Forwarded-For or all clients share one rate-limit bucket.
# Set by infra/compose/docker-compose.yml (api service) and infra/scripts/bootstrap.sh; only set it yourself when a proxy that overwrites X-Forwarded-For is in front.
# CSO_TRUST_PROXY=false
# CSO_COOKIE_SECURE=auto         # auto | true | false

# Sign in with OpenStreetMap. Register the app at https://www.openstreetmap.org/oauth2/applications
# (scope read_prefs; confidential on). Put these in backend/.env, not here: the secret is shown once.
# CSO_OSM_OAUTH_CLIENT_ID=
# CSO_OSM_OAUTH_CLIENT_SECRET=
# CSO_OSM_OAUTH_REDIRECT_URL=http://127.0.0.1:8000/api/v1/auth/osm/callback
# Locally, open the site at http://127.0.0.1:5173 (not localhost) and set this, so the sign-in cookie
# is sent back to the same host after OpenStreetMap redirects to 127.0.0.1.
# CSO_WEB_BASE_URL=http://127.0.0.1:5173
# Who may become the workspace admin: OSM user ids (numbers), comma-separated. Find yours at
# https://www.openstreetmap.org/user/<name> (the id is in the page's "view history" links) or
# https://api.openstreetmap.org/api/0.6/user/details.json while signed in. Not a secret.
# With this empty, nobody can claim a fresh workspace from the web; use
# `cso auth create-invite --role admin` instead.
# CSO_BOOTSTRAP_ADMIN_OSM_UIDS=
# Optional: only these OSM user ids may sign in at all (empty lets every OSM account in).
# CSO_OSM_SIGNIN_ALLOWED_UIDS=
