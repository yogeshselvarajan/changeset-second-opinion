{
  "name": "cso-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run numbers && tsc --noEmit && vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/build-docs.mjs && node scripts/check-dist.mjs",
    "numbers": "node scripts/landing-numbers.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "generate:api": "openapi-ts -f openapi-ts.config.ts",
    "icons": "node scripts/icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "size": "size-limit"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "cmdk": "1.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.59.0",
    "maplibre-gl": "6.15.0",
    "motion": "14.4.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^11.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "size-limit": "^11.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "size-limit": [
    {
      "name": "app entry chunk (gzip)",
      "path": "dist/assets/index-*.js",
      "gzip": true,
      "limit": "250 kB"
    },
    {
      "name": "home page chunk and styles (gzip)",
      "path": [
        "dist/assets/LandingRoutes-*.js",
        "dist/assets/index-*.css"
      ],
      "gzip": true,
      "limit": "90 kB"
    }
  ]
}
