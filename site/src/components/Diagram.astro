---
// A diagram with a light background, shown on a neutral card so it reads the same in both themes.
// The caller passes the full text alternative; a longer description belongs in the page text.
import { Image } from "astro:assets";

interface Props {
  name: string;
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;
const files = import.meta.glob("../assets/diagrams/*.png", { eager: true });
const file = files[`../assets/diagrams/${name}.png`] as { default: ImageMetadata } | undefined;
if (!file) {
  throw new Error(`Diagram: missing image "${name}" in src/assets/diagrams`);
}
---

<figure class="diagram">
  <div class="diagram-card">
    <Image src={file.default} alt={alt} widths={[640, 960, 1280, 1680]} sizes="(min-width: 50rem) 46rem, 100vw" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
  }
  .diagram-card {
    background: #ffffff;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    padding: 0.75rem;
    overflow: hidden;
  }
  .diagram-card img {
    display: block;
    width: 100%;
    height: auto;
  }
  .diagram figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
